# FinAI Environment Configuration
# Copy this file to .env and fill in your keys (do not commit .env to git)

# Google Gemini API Key (Free from https://aistudio.google.com/)
GEMINI_API_KEY=

# Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: Supabase / Database URL (defaults to local SQLite if omitted)
DATABASE_URL=
